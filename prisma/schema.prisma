generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  IDEA
  RESEARCHING
  VALIDATING
  VALIDATED
  BUILDING
  PUBLISHED
  EARNING
  SCALING
  PAUSED
  REJECTED
}

enum HalalStatus {
  HALAL
  REVIEW_REQUIRED
  NOT_ALLOWED
}

enum BusinessModel {
  DIGITAL_PRODUCT
  AFFILIATE
  SAAS
  PRINTABLE
  EDUCATIONAL
  MARKETPLACE
}

enum Category {
  CHILDRENS_BOOKS
  EDUCATIONAL_RESOURCES
  TEACHER_RESOURCES
  PRINTABLES
  AFFILIATE
  DIGITAL_TOOLS
  SAAS
}

enum ProductType {
  COLORING_BOOK
  DRAWING_BOOK
  ACTIVITY_BOOK
  WORKSHEET
  WORKBOOK
  PRINTABLE
  TEACHER_RESOURCE
  DIGITAL_TOOL
  AFFILIATE_WEBSITE
  SAAS
}

enum ProductStatus {
  PLANNED
  IN_DEVELOPMENT
  READY
  PUBLISHED
  PAUSED
  RETIRED
}

enum ExperimentStatus {
  PLANNED
  READY
  RUNNING
  ACTIVE
  COMPLETED
  STOPPED
  ITERATING
  FAILED
  PAUSED
}

enum ExperimentDecision {
  SCALE
  ITERATE
  PAUSE
  KILL
  WIN
  STOP
  INSUFFICIENT_DATA
}

/// Status of a persisted Handoff row (Phase 5 lifecycle). Named distinctly
/// from Phase 4's candidate-level "HandoffStatus" enum in Postgres.
enum HandoffRecordStatus {
  DRAFT
  HANDOFF_READY
  ACCEPTED
  REJECTED
  COMPLETED
}

enum HandoffRecommendedExperimentType {
  MVP_BUILD
  ASSET_LAUNCH
}

enum RevenueSource {
  PRODUCT_SALES
  AFFILIATE_COMMISSION
  SAAS_SUBSCRIPTION
  ADS
  OTHER
}

enum AgentType {
  RESEARCH
  VALIDATION
  PRODUCT
  AFFILIATE
  SEO
  QA
  ANALYTICS
  GROWTH
  BUSINESS_MANAGER
}

enum AgentStatus {
  ACTIVE
  IDLE
  ERROR
  DISABLED
}

enum ResearchRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SignalStatus {
  SUPPORTED
  MIXED
  INSUFFICIENT
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DiscoveryCandidateStatus {
  GENERATED
  RESEARCHING
  RESEARCHED
  SKIPPED_DUPLICATE
}

enum MetricDataClass {
  REAL_DATA
  ESTIMATED_DATA
}

enum HandoffStatus {
  NOT_READY
  READY
  PREPARED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Multi-tenant account (Phase 6A). passwordHash is scrypt-format
/// (scrypt$N$r$p$salt$hash) and is NEVER returned through APIs.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String     @default("")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions       Session[]
  opportunities  Opportunity[]
  products       Product[]
  revenueEntries RevenueEntry[]
  discoveryRuns  DiscoveryRun[]
  agentRuns      AgentRun[]

  @@index([status])
}

/// Server-side session. Only the SHA-256 hash of the session token is stored,
/// so a database leak never exposes usable session tokens.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Opportunity {
  id                        String            @id @default(cuid())
  title                     String
  category                  Category
  businessModel             BusinessModel
  targetAudience            String            @default("")
  problemSolved             String            @default("")
  monetizationMethod        String            @default("")
  estimatedStartupCost      Decimal           @db.Decimal(12, 2)
  demandScore               Int
  competitionScore          Int
  commercialIntentScore     Int
  automationScore           Int
  differentiationScore      Int
  monetizationStrengthScore Int
  halalScore                Int
  halalStatus               HalalStatus
  overallScore              Decimal           @db.Decimal(6, 1)
  confidence                Int
  status                    OpportunityStatus
  ownerId                   String?
  owner                     User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  evidence                  String[]          @default([])
  risks                     String[]          @default([])
  nextAction                String            @default("")
  isSample                  Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  products               Product[]
  experiments            Experiment[]
  revenueEntries         RevenueEntry[]
  researchRuns           ResearchRun[]
  handoffs               Handoff[]
  discoveryCandidates    DiscoveryCandidate[]
  lastResearchRunId      String?
  lastResearchAt         DateTime?
  lastResearchConclusion String?
  researchRunCount       Int                  @default(0)

  @@index([status])
  @@index([category])
  @@index([halalStatus])
  @@index([overallScore])
  @@index([updatedAt])
  @@index([isSample])
  @@index([ownerId])
}

model Product {
  id             String         @id @default(cuid())
  name           String
  type           ProductType
  targetAudience String         @default("")
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  status         ProductStatus
  price          Decimal        @db.Decimal(12, 2)
  cost           Decimal        @db.Decimal(12, 2)
  revenue        Decimal        @db.Decimal(12, 2)
  platform       String         @default("")
  productUrl     String?
  affiliateUrl   String?
  metrics        Json?
  notes          String         @default("")
  isSample       Boolean        @default(false)
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  revenueEntries RevenueEntry[]

  @@index([opportunityId])
  @@index([status])
  @@index([isSample])
  @@index([ownerId])
}

model Experiment {
  id              String              @id @default(cuid())
  hypothesis      String
  opportunityId   String
  opportunity     Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  target          String
  budget          Decimal             @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  expectedResult  String              @default("")
  actualResult    String?
  objective       String              @default("")
  successCriteria String[]            @default([])
  metrics         Json?
  result          String?
  notes           String              @default("")
  feedback        Json?
  visitors        Int                 @default(0)
  leads           Int                 @default(0)
  clicks          Int                 @default(0)
  sales           Int                 @default(0)
  revenue         Decimal             @db.Decimal(12, 2)
  profit          Decimal             @db.Decimal(12, 2)
  conversionRate  Decimal             @db.Decimal(8, 4)
  decision        ExperimentDecision?
  status          ExperimentStatus
  handoffId       String?
  handoff         Handoff?            @relation(fields: [handoffId], references: [id], onDelete: SetNull)
  isSample        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  metricEvents ExperimentMetric[]

  @@index([opportunityId])
  @@index([status])
  @@index([handoffId])
  @@index([updatedAt])
  @@index([isSample])
}

/// Phase 6B — one raw measurement record for an experiment over a reporting
/// period (a day, a week, or any arbitrary window). Append-only by policy:
/// corrections are recorded as new rows, never silent rewrites of history.
/// Only RAW recorded data lives here; derived metrics (CTR, profit, ROI, …)
/// are always calculated from these rows and never persisted as measurements.
model ExperimentMetric {
  id           String          @id @default(cuid())
  experimentId String
  experiment   Experiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  recordedAt   DateTime
  periodStart  DateTime
  periodEnd    DateTime
  impressions  Int?
  clicks       Int?
  visits       Int?
  leads        Int?
  conversions  Int?
  revenue      Decimal?        @db.Decimal(14, 2)
  cost         Decimal?        @db.Decimal(14, 2)
  currency     String          @default("USD")
  source       String          @default("")
  dataClass    MetricDataClass @default(REAL_DATA)
  notes        String          @default("")
  recordedBy   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([experimentId, periodStart, periodEnd, source])
  @@index([experimentId])
  @@index([experimentId, recordedAt])
  @@index([periodStart])
}

/// Machine-readable Opportunity Handoff Contract persisted at the AIAgent →
/// AI Income Lab boundary. The contract JSON is validated before HANDOFF_READY.
model Handoff {
  id                    String                           @id @default(cuid())
  opportunityId         String
  opportunity           Opportunity                      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contractVersion       Int                              @default(1)
  contract              Json
  status                HandoffRecordStatus              @default(DRAFT)
  validationConclusion  String?
  confidence            Decimal?                         @db.Decimal(6, 4)
  score                 Decimal?                         @db.Decimal(6, 1)
  recommendedExperiment HandoffRecommendedExperimentType @default(MVP_BUILD)
  experimentHypothesis  String
  successCriteria       String[]                         @default([])
  budgetLimit           Decimal?                         @db.Decimal(12, 2)
  timeLimitDays         Int?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  experiments Experiment[]

  @@index([opportunityId])
  @@index([status])
  @@index([createdAt])
}

model RevenueEntry {
  id              String        @id @default(cuid())
  date            DateTime
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  revenueSource   RevenueSource
  grossRevenue    Decimal       @db.Decimal(12, 2)
  fees            Decimal       @db.Decimal(12, 2)
  advertisingCost Decimal       @db.Decimal(12, 2)
  otherCosts      Decimal       @db.Decimal(12, 2)
  netRevenue      Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  referenceNote   String        @default("")
  isSample        Boolean       @default(false)
  ownerId         String?
  owner           User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
  @@index([opportunityId])
  @@index([productId])
  @@index([revenueSource])
  @@index([isSample])
  @@index([ownerId])
}

model Agent {
  id          String      @id @default(cuid())
  name        String
  type        AgentType
  description String      @default("")
  status      AgentStatus @default(DISABLED)
  lastRun     DateTime?
  placeholder Boolean     @default(true)
  isSample    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agentRuns   AgentRun[]

  @@unique([name, type])
  @@index([type])
  @@index([status])
  @@index([isSample])
}

/// Execution record for an agent task. Designed so future autonomous agents can
/// be added without schema changes: task, input/output and metadata are open JSON.
model AgentRun {
  id          String         @id @default(cuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task        String
  status      AgentRunStatus @default(RUNNING)
  ownerId     String?
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  input       Json?
  output      Json?
  errors      String[]       @default([])
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([agentId])
  @@index([ownerId])
  @@index([status])
  @@index([startedAt])
}

model ResearchRun {
  id                 String            @id
  opportunityId      String
  opportunity        Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status             ResearchRunStatus
  startedAt          DateTime
  completedAt        DateTime?
  confidence         Decimal           @db.Decimal(6, 4)
  conclusion         String?
  conclusionBasis    String?
  providersAttempted String[]          @default([])
  providersSucceeded String[]          @default([])
  providerStatuses   Json?
  validationSignals  Json?
  scoreIntegration   Json?
  errors             String[]          @default([])
  queries            ResearchQuery[]
  sources            ResearchSource[]
  evidence           Evidence[]
  findings           ResearchFinding[]
  validation         Validation?

  @@index([opportunityId])
  @@index([startedAt])
  @@index([status])
}

model ResearchQuery {
  id            String      @id @default(cuid())
  researchRunId String
  researchRun   ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  query         String
  source        String
  purpose       String
  createdAt     DateTime    @default(now())

  @@index([researchRunId])
  @@index([source])
}

model Evidence {
  id               String            @id
  researchRunId    String
  researchRun      ResearchRun       @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  researchSourceId String?
  researchSource   ResearchSource?   @relation(fields: [researchSourceId], references: [id], onDelete: SetNull)
  source           String
  title            String
  url              String
  snippet          String            @default("")
  collectedAt      DateTime
  relevanceScore   Decimal           @db.Decimal(6, 4)
  qualityScore     Decimal           @db.Decimal(6, 4)
  hash             String
  supports         String[]          @default([])
  contradicts      String[]          @default([])
  dataClass        String            @default("REAL_LIVE_DATA")
  findings         ResearchFinding[] @relation("FindingEvidence")

  @@unique([researchRunId, hash])
  @@index([researchRunId])
  @@index([hash])
  @@index([source])
  @@index([researchSourceId])
}

/// One row per provider per research run: which provider produced which evidence,
/// with what queries, and whether it succeeded, failed, or was unconfigured.
model ResearchSource {
  id            String      @id @default(cuid())
  researchRunId String
  researchRun   ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  provider      String
  status        String
  error         String?
  evidenceCount Int         @default(0)
  queries       String[]    @default([])
  createdAt     DateTime    @default(now())
  evidence      Evidence[]

  @@unique([researchRunId, provider])
  @@index([researchRunId])
  @@index([provider])
}

/// Persisted validation layer. Every signal keeps the evidence ids it is based on
/// so validation stays traceable to evidence end to end.
model Validation {
  id                          String       @id @default(cuid())
  researchRunId               String       @unique
  researchRun                 ResearchRun  @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  demandStatus                SignalStatus
  demandEvidenceIds           String[]     @default([])
  painPointStatus             SignalStatus
  painPointEvidenceIds        String[]     @default([])
  commercialIntentStatus      SignalStatus
  commercialIntentEvidenceIds String[]     @default([])
  trendStatus                 SignalStatus
  trendEvidenceIds            String[]     @default([])
  competitionStatus           SignalStatus
  competitionEvidenceIds      String[]     @default([])
  evidenceCoverage            Int          @default(0)
  sourceDiversity             Int          @default(0)
  contradictionCount          Int          @default(0)
  confidence                  Decimal      @db.Decimal(6, 4)
  conclusion                  String
  conclusionBasis             String       @default("")
  createdAt                   DateTime     @default(now())

  @@index([conclusion])
}

model ResearchFinding {
  id             String      @id
  researchRunId  String
  researchRun    ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  claim          String
  summary        String      @default("")
  confidence     Decimal     @db.Decimal(6, 4)
  evidenceIds    String[]    @default([])
  contradictions String[]    @default([])
  evidence       Evidence[]  @relation("FindingEvidence")

  @@index([researchRunId])
}

/// One autonomous discovery job: topic/category in, ranked opportunity briefs out.
model DiscoveryRun {
  id                   String               @id @default(cuid())
  topic                String
  category             String
  status               DiscoveryRunStatus
  ownerId              String?
  owner                User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  startedAt            DateTime             @default(now())
  completedAt          DateTime?
  candidateCount       Int                  @default(0)
  researchedCount      Int                  @default(0)
  readyForHandoffCount Int                  @default(0)
  errors               String[]             @default([])
  notes                String               @default("")
  candidates           DiscoveryCandidate[]

  @@index([status])
  @@index([ownerId])
  @@index([startedAt])
  @@index([category])
}

/// A discovery candidate researched through the existing orchestrator.
/// Evidence, validation, and scores live on the linked ResearchRun — this row
/// only stores discovery metadata, ranking, the brief, and the handoff contract.
model DiscoveryCandidate {
  id                   String                   @id @default(cuid())
  discoveryRunId       String
  discoveryRun         DiscoveryRun             @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  title                String
  category             String
  problemHypothesis    String                   @default("")
  targetAudience       String                   @default("")
  normalizedKey        String
  status               DiscoveryCandidateStatus @default(GENERATED)
  opportunityId        String?
  opportunity          Opportunity?             @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  researchRunId        String?
  rank                 Int?
  rankingScore         Decimal?                 @db.Decimal(6, 1)
  confidence           Decimal?                 @db.Decimal(6, 4)
  validationConclusion String?
  evidenceCount        Int                      @default(0)
  evidenceCoverage     Int                      @default(0)
  sourceDiversity      Int                      @default(0)
  contradictionCount   Int                      @default(0)
  brief                Json?
  rankingBreakdown     Json?
  handoffPayload       Json?
  handoffStatus        HandoffStatus            @default(NOT_READY)
  errors               String[]                 @default([])
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([discoveryRunId, normalizedKey])
  @@index([discoveryRunId])
  @@index([status])
  @@index([handoffStatus])
  @@index([opportunityId])
  @@index([researchRunId])
}
