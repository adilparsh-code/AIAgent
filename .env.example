# Server-side research provider keys. Never expose these as NEXT_PUBLIC_* variables.
BRAVE_SEARCH_API_KEY=

# Optional. SerpApi key for Google Trends (Google has no official Trends API).
SERPAPI_API_KEY=

# PostgreSQL connection string used only on the server. Never expose as NEXT_PUBLIC_*.
# Replace USER, PASSWORD, HOST, PORT, and DATABASE with your own values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Required only when TOTP two-factor authentication is used. 32 random bytes, hex encoded.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# One-time first-admin bootstrap guard (see scripts/create-first-admin.ts).
# Set to CREATE_FIRST_ADMIN only for that single command; never commit a real value.
ADMIN_BOOTSTRAP_CONFIRM=
